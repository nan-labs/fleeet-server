# Database connection
DATABASE_URL=postgres://fleeet:strongpassword@localhost:5432/fleeet

# Database password (used by docker-compose only)
POSTGRES_PASSWORD=strongpassword

# Admin token (minimum 32 characters)
FLEEET_ADMIN_TOKEN=your-secure-random-token-here-at-least-32-chars

# Server configuration
PORT=3000
FLEEET_PUBLIC_URL=http://localhost:3000
